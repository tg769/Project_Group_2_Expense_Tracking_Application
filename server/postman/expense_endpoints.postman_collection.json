{
  "info": {
    "name": "Expense Tracker - Expense Endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET all expenses",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () { pm.response.to.have.status(200); });",
              "pm.test(\"Returns a list of 24 expenses\", function () { pm.expect(pm.response.json()).to.have.lengthOf(24); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses"
          ]
        }
      }
    },
    {
      "name": "2. POST valid expense",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"Returns the new expense\", function () { var e = pm.response.json(); pm.expect(e.amount).to.eql(12.5); pm.expect(e.category).to.eql(\"Groceries\"); pm.collectionVariables.set(\"newId\", e.id); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/expenses",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 12.5,\n  \"category\": \"Groceries\",\n  \"expense_date\": \"2026-10-28\",\n  \"description\": \"Bread and milk\"\n}"
        }
      }
    },
